{
  "name": "oxford5000-app",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "predev": "lsof -ti:5173 | xargs kill -9 2>/dev/null || true",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "test:pwa": "node e2e/pwa-update.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.52.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/traverse": "7.29.7",
    "@babel/parser": "7.29.7"
  }
}
